# fastify
FASTIFY_ADDRESS=0.0.0.0
PORT=12008
FASTIFY_OPTIONS=true
FASTIFY_TRUST_PROXY=true
FASTIFY_BODY_LIMIT=1048576
FASTIFY_MAX_PARAM_LENGTH=100

# grpc
GRPC_ADDRESS=0.0.0.0
GRPC_PORT=13008

# mongodb
MONGO_URI=mongodb://localhost:27017
MONGO_DB=llm-api
MONGO_USER=localuser
MONGO_PASS=local

# redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=10
REDIS_USERNAME=localuser
REDIS_PASSWORD=local
REDLOCK_URI=redis://localuser:local@localhost:6379/11

# cookie
COOKIE_SECRET=local

# kafka
KAFKA_CLIENTID=llm-api
KAFKA_BROKERS=localhost:39094
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=localuser
KAFKA_SASL_PASSWORD=local
KAFKA_STATISTIC_TOPIC=statistic
KAFKA_STATISTIC_GROUPID=statistic-llm-api
KAFKA_AGENT_TASK_TOPIC=agent_task
KAFKA_AGENT_TASK_GROUPID=agent-task-llm-api

# ucenter
UCENTER_URI=http://localhost:12001
UCENTER_URI_INTRANET=http://localhost:12001
UCENTER_GRPC=localhost:13001

# LLM 模型：走中转站（OpenAI 兼容），模型按「族 × 档」命名，定义见 conf/llmModel.js
# 只需要下面两个值；换后端供应商、换真实模型名都属于中转站的渠道配置，本服务不再逐家配 URI/KEY/MODEL
LLM_RELAY_BASE_URL=http://127.0.0.1:3009/v1
LLM_RELAY_API_KEY=
# 全局默认档位（留空即文本 relay_common_pro、带图 relay_qwen_vl_pro）
#LLM_DEFAULT_CONFIG_KEY=relay_common_pro
#LLM_DEFAULT_VL_CONFIG_KEY=relay_qwen_vl_pro
# 单个档位可单独覆盖，键名 = <模型key>_<字段>，字段含 model/baseURL/apiKey/maxTokens/contextWindow/temperature/stream/tokenizer/imageTokens/enableThinking
#relay_qwen_pro_model=qwen3-max
#relay_common_low_maxTokens=8192
#relay_deepseek_pro_enableThinking={"thinking":{"type":"enabled"}}
# 后台任务与预览档位（记忆抽取走 flash、降级走 low）
#memory_extract_model=relay_common_flash
#memory_extract_fallbackModel=relay_common_low
#context_previewModel=relay_common_pro

# resource
RESOURCE_URI=http://localhost:12007
RESOURCE_URI_INTRANET=http://localhost:12007
RESOURCE_GRPC=localhost:13007

# transform
TRANSFORM_URI=http://localhost:8000
TRANSFORM_URI_INTRANET=http://localhost:8000
TRANSFORM_GRPC=localhost:50051

# mcp
MCP_SEARXNG_URI=http://localhost:32769/sse
MCP_SEARXNG_HTTP_URI=http://localhost:32767/mcp
